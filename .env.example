# =============================================================
# Agente de IA para Bolão da Copa do Mundo (n8n)
# Este arquivo é apenas uma LISTA do que você precisa configurar.
# No n8n, crie as credenciais em "Credentials" e substitua os
# placeholders do workflow.json (SUA_CHAVE_AQUI, ID_DO_GRUPO@g.us).
# Nunca coloque valores reais neste arquivo.
# =============================================================

# --- API de futebol (Zafronix: seleções, jogos e placares) ---
# Vai no header X-API-Key dos 3 nós HTTP Request
ZAFRONIX_API_KEY=
# URL base usada pelo workflow: https://api.zafronix.com/fifa/worldcup/v1

# --- WhatsApp (Evolution API) ---
# Credencial "Evolution API" no n8n
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# O nome da instância chega no payload do webhook (body.instance)
EVOLUTION_INSTANCE_NAME=
# ID do grupo autorizado a falar com o agente (formato 1234567890-123456@g.us)
WHATSAPP_GROUP_ID=

# --- Webhook ---
# No Evolution API, configure o webhook da instância para:
# https://SEU_N8N/webhook/bolao-copa
N8N_WEBHOOK_URL=

# --- Modelo de linguagem (OpenRouter) ---
# Credencial "OpenRouter" no n8n. Modelo usado: openai/gpt-5-mini
OPENROUTER_API_KEY=

# --- Banco de dados (Supabase / PostgreSQL) ---
# Credencial "Supabase" no n8n (inserir e atualizar seleções e jogos)
SUPABASE_HOST=
SUPABASE_SERVICE_ROLE_KEY=

# Credencial "Postgres" no n8n (ferramenta de SQL do agente)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=require

# --- Memória de conversa (Redis) ---
# Credencial "Redis" no n8n (janela das últimas 3 mensagens por usuário)
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# --- Outros ---
# Fuso usado no prompt e nos filtros de data
TZ=America/Sao_Paulo
